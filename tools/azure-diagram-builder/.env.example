# Copy to .env and fill in. Never commit the result.
#
# These are RUNTIME values, read by the token server inside the container.
# Build-time values (model names shown in the UI) are baked into the image by
# the pipeline - see README.md.

# --- Image selection -------------------------------------------------------
# Pin to an upstream version (e.g. 1.0.0) instead of tracking latest.
IMAGE_TAG=latest
# Port on the VPS loopback interface that the reverse proxy forwards to.
HOST_PORT=8080

# --- Azure OpenAI (required) ----------------------------------------------
# The container proxies all model calls through /api/openai; the key never
# reaches the browser. Managed identity is not available outside Azure, so a
# key is required here.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=

# --- MCP server (optional, exposed at /mcp) -------------------------------
# Leave empty ONLY if /mcp is blocked in the reverse proxy. Any value set here
# is enforced as `Authorization: Bearer <token>`.
MCP_AUTH_TOKEN=

# --- Import from Azure (optional) -----------------------------------------
# Reads a live resource group through the *server* identity. There is no
# managed identity on a VPS, so keep this off unless you mount credentials.
AZURE_IMPORT_ENABLED=false

# --- Features that require an Azure managed identity ----------------------
# These do not work on a plain VPS and are listed for completeness only:
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_RESOURCE_ID=
# AZURE_COSMOS_ENDPOINT=
