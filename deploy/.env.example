# Copy to deploy/.env on the VPS and fill in. Never commit the filled-in copy.
#
#   openssl rand -hex 32

# Bearer token clients send to the gateway. The gateway will not start without it.
MCP_GATEWAY_TOKEN=

# Bearer token between the gateway and the diagram-builder backend. Internal only -
# no client ever sees it.
DIAGRAMS_MCP_TOKEN=

# Host port cloudflared points at. Set it here rather than in the compose file,
# which is overwritten on every update.
GATEWAY_HOST_PORT=8191
